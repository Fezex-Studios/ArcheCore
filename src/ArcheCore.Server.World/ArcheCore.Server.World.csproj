<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!--
        Console/worker Exe projects default to Workstation GC, which is
        tuned for a desktop app doing occasional small allocations with a
        premium on pause latency for UI responsiveness. A server fielding
        thousands of concurrent socket sends/receives per second - each
        one allocating via MessagePack serialization, NetDataWriter, etc
        - is exactly the workload Server GC exists for: multiple heaps,
        one per core, collected in parallel, built for throughput under
        sustained allocation pressure instead of minimizing any single
        pause. ConcurrentGarbageCollection keeps most Gen2 work off the
        thread doing the actual collection so it doesn't have to fully
        stop everything.

        This was almost certainly the direct cause of TickHealth logging
        183 Gen2 collections in one 5-second window with p99 tick time
        over 9 seconds - Workstation GC's pauses stacking up on the
        single tick thread under an allocation rate it was never designed
        for.
        -->
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BepuPhysics" Version="2.5.0-beta.29" />
      <PackageReference Include="BepuUtilities" Version="2.5.0-beta.29" />
      <PackageReference Include="LiteNetLib" Version="2.1.4" />
      <PackageReference Include="MessagePack" Version="3.1.7" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-preview.5.26302.115" />
      <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-preview.5.26302.115" />
      <PackageReference Include="MoonSharp" Version="2.0.0" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
      <PackageReference Include="NLog" Version="6.1.3" />
      <PackageReference Include="NLog.Extensions.Logging" Version="6.1.3" />
      <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    </ItemGroup>
    <PropertyGroup>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>
    <ItemGroup>
      <Folder Include="Core\Lua\DeveloperSDK\" />
      <Folder Include="Core\Network\" />
      <Folder Include="Core\PersistenceServer\" />
      <Folder Include="Data\" />
      <Folder Include="LuaSDK\" />
      <Folder Include="Physics\" />
      <Folder Include="Services\" />
      <Folder Include="Utils\Database\MySQL\" />
    </ItemGroup>

    <ItemGroup>
      <None Update="nlog.config">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="appsettings.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
        <None Update="Data\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="Lua\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="SQL\**\*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="SQL\patches\readme.md">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="worldserver.db">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ArcheCore.Network\ArcheCore.Network.csproj" />
    </ItemGroup>

</Project>
