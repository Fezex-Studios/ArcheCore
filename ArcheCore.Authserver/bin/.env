# AuthServer .env
# Never commit this file to source control — add .env to your .gitignore

PORT=3000

AUTH_DATABASE_PATH=./auth.db
GAME_DATABASE_PATH=./gamedata.db

# Generate this with: openssl rand -hex 32
# Copy the same value into ServerConfig.json on the WorldServer
INTERNAL_SECRET=replace_this_with_a_real_secret
