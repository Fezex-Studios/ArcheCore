# ══════════════════════════════════════════════════════════════════════════════
#  ArcheCore .gitignore
#  Covers: Unity Client, C# Servers, Node.js AuthServer, Python DevTools
# ══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
#  SECURITY — Never commit these
# ─────────────────────────────────────────────────────────────────────────────

# Plaintext game database (encrypt before committing the encrypted version)
**/_oggamedata.db

# Any decrypted DB sitting in temp locations
**/gamedata_decrypted.db
**/plaintext_*.db

# Environment / secrets files
.env
.env.*
*.env
**/appsettings.Production.json
**/appsettings.Local.json

# AES keys, certs, tokens
*.pem
*.key
*.pfx
*.p12


# ─────────────────────────────────────────────────────────────────────────────
#  UNITY CLIENT  (ArcheCore.Client/)
# ─────────────────────────────────────────────────────────────────────────────

# Generated by Unity — never commit
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
MemoryCaptures/
Recordings/

# Unity crash reports
sysinfo.txt
crashlytics-build.properties

# Asset pipeline cache
*.pidb
*.suo
*.userprefs
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Unity3D generated meta files — DO commit these for tracked assets
# (commented out intentionally — meta files should be tracked)
# *.meta

# Unity package manager lock (commit this — it pins package versions)
# Packages/packages-lock.json  ← DO commit

# Build artifacts inside the project
Assets/StreamingAssets/GameData/gamedata.db   # generated by DevTools — commit the encrypted copy if you want it bundled

# Unity cloud build
/Assets/Editor/Data/

# Rider / VS / VSCode
.idea/
*.sln.DotSettings.user
.vs/
*.user
*.suo
.vscode/
*.code-workspace

# JetBrains Rider
.idea/

# Visual Studio cache
.vs/

# Unity VCS hidden folders (Unity Plastic SCM — not needed if using Git)
.plastic/
.collab/


# ─────────────────────────────────────────────────────────────────────────────
#  C# SERVERS  (ArcheCore.Server.World / Auth / Persistence / Network)
# ─────────────────────────────────────────────────────────────────────────────

# Build output
[Bb]in/
[Oo]bj/
out/

# NuGet
*.nupkg
*.snupkg
**/packages/
!**/packages/repositories.config
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# .NET runtime files
*.runtimeconfig.json
*.runtimeconfig.dev.json
*.deps.json

# Publish output
**/publish/

# SQLite databases generated at runtime (patched on boot, not committed)
# Exception: you MAY commit a seed/baseline db — see note below
**/Data/gamedata.db
**/Data/world.db
**/bin/**/gamedata.db

# SQL patch tracking is in the DB itself — patches/*.sql SHOULD be committed
# DO NOT add SQL/patches/ here

# Log files
*.log
[Ll]ogs/
nlog*.xml
nlog*.config.bak

# Server config with secrets
appsettings.Development.json
appsettings.Secrets.json


# ─────────────────────────────────────────────────────────────────────────────
#  NODE.JS AUTH SERVER  (ArcheCore.Server.Auth/)
# ─────────────────────────────────────────────────────────────────────────────

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# TypeScript build output
dist/
*.js.map

# Auth server runtime DB (generated, not source)
**/src/gamedata.db

# PM2 logs / runtime
.pm2/


# ─────────────────────────────────────────────────────────────────────────────
#  PYTHON DEVTOOLS  (ArcheCore.DevTools/)
# ─────────────────────────────────────────────────────────────────────────────

__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
*.manifest

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# PyCharm
.idea/


# ─────────────────────────────────────────────────────────────────────────────
#  OS GENERATED
# ─────────────────────────────────────────────────────────────────────────────

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


# ─────────────────────────────────────────────────────────────────────────────
#  WHAT TO EXPLICITLY KEEP (overrides above patterns)
# ─────────────────────────────────────────────────────────────────────────────

# Keep SQL patches — these are source of truth for your schema
!**/SQL/patches/*.sql

# Keep Unity .meta files for tracked assets
!Assets/**/*.meta

# Keep NuGet package lock (pins versions for the team)
!**/packages.lock.json

# Keep the encrypted gamedata.db in StreamingAssets if you bundle it
# (comment this out if you generate it in CI instead)
!Assets/StreamingAssets/GameData/gamedata.db


./.idea

src/ArcheCore.Server.World.zip
src/src.zip
src/ArcheCore.Server.World.zip
/src/AIDev
*.zip
